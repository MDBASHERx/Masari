# Server port
PORT=5000

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key
SUPABASE_SERVER_KEY=

# Frontend URL
CLIENT_URL=http://localhost:5173

# AI provider: "mock" until the team picks a real one
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini
AI_TIMEOUT_MS=30000
AI_MAX_CONCURRENT=2

# development | production
NODE_ENV=development

# Local demo reply endpoint
CHAT_DEMO_ENABLED=false