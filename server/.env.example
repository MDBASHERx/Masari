# Server Port
PORT=5000

# DATABASE
# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only: grading and score writes. Never put it in client/.env
SUPABASE_SERVER_KEY=

# FRONTEND URL
# React Client URL
CLIENT_URL= "http://localhost:5173"

# AI provider: "mock" until the team picks a real one
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
AI_TIMEOUT_MS=30000

# development | production
NODE_ENV=development