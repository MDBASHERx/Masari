# Server port
PORT=5000

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key
SUPABASE_SERVER_KEY=

# Frontend URL
CLIENT_URL=http://localhost:5173

# Gemini for the app; mock is for offline tests only
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini
AI_TIMEOUT_MS=30000
AI_MAX_CONCURRENT=2

# development | production
NODE_ENV=development

# Legacy setting: keep false; the demo endpoint has been removed
CHAT_DEMO_ENABLED=false
